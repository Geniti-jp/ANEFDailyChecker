<Window x:Class="ANEFDailyChecker.TimerRecoveryInputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="現在値を入力" Width="280" Height="260"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleLabel" Grid.Row="0"
                   Text="" FontWeight="Bold"
                   Margin="0,0,0,4"/>
        <TextBlock x:Name="MaxLabel" Grid.Row="1"
                   Text="" Foreground="Gray"
                   Margin="0,0,0,10"/>

        <TextBlock Grid.Row="2" Text="現在値" Margin="0,0,0,4"/>
        <TextBox x:Name="CurrentValueBox" Grid.Row="3"
                 FontSize="16" TextAlignment="Center"
                 Margin="0,0,0,10"/>

        <TextBlock Grid.Row="4" Text="次の回復までの残り時間（MM:SS）" Margin="0,0,0,4"/>
        <TextBox x:Name="RemainingBox" Grid.Row="5"
                 FontSize="16" TextAlignment="Center"
                 MaxLength="7" KeyDown="RemainingBox_KeyDown"/>

        <Button Content="開始" Grid.Row="7"
                Height="30" Click="OkClick"/>
    </Grid>
</Window>
