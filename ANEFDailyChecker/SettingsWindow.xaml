<Window x:Class="ANEFDailyChecker.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="設定" Width="460" Height="480">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- メモ追加（テキスト + ボタン） -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <Button Content="追加" DockPanel.Dock="Right" Width="50" Click="AddMemo"/>
            <TextBox x:Name="MemoText" Margin="0,0,5,0" KeyDown="MemoText_KeyDown"/>
        </DockPanel>

        <!-- リセット時刻 + 最前面固定/時刻表示 + タイマー設定 -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="55"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="リセット時刻 (hh:mm)" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="ResetTimeBox" Grid.Column="1" VerticalAlignment="Center"/>
            <CheckBox x:Name="TopmostFeatureCheckBox" Grid.Column="3" Content="最前面固定/時刻表示"
                      VerticalAlignment="Center" Margin="10,0,0,0"/>
            <Button Grid.Column="4" Content="タイマー設定" Width="80" Margin="10,0,0,0" Click="OpenTimerSettings"/>
        </Grid>

        <!-- メモ一覧 -->
        <ListBox x:Name="MemoList" Grid.Row="2" DisplayMemberPath="Text">
            <ListBox.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="編集" Click="EditMemo"/>
                    <MenuItem Header="削除" Click="DeleteMemo"/>
                </ContextMenu>
            </ListBox.ContextMenu>
        </ListBox>

        <!-- 並び替えボタン -->
        <Button Content="↑ 上へ" Grid.Row="3" Margin="0,10,0,5" Click="MoveUp"/>
        <Button Content="↓ 下へ" Grid.Row="4" Margin="0,0,0,10" Click="MoveDown"/>

        <!-- 閉じるボタン -->
        <Button Content="閉じる" Grid.Row="5" Height="28" Click="CloseClick"/>
    </Grid>
</Window>
