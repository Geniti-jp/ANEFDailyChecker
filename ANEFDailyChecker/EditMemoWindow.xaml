<Window x:Class="ANEFDailyChecker.EditMemoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="メモの編集" Width="350" Height="720" WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 内容 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="内容" Margin="0,0,0,5"/>
            <TextBox x:Name="ParentTextBox"/>
        </StackPanel>

        <!-- リセット日数 / 次回リセットまでの日数 -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBlock Text="リセット日数" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="ResetCountBox" Width="44" VerticalAlignment="Center"/>
                <TextBlock Text="日" VerticalAlignment="Center" Margin="3,0,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <TextBlock Text="次回まで" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="RemainingCountBox" Width="44" VerticalAlignment="Center"/>
                <TextBlock Text="日" VerticalAlignment="Center" Margin="3,0,0,0"/>
            </StackPanel>
        </Grid>

        <!-- グループモード -->
        <CheckBox x:Name="GroupCheckBox" Grid.Row="2" Content="グループモードで使用する"
                  Margin="0,0,0,6" Checked="GroupModeChanged" Unchecked="GroupModeChanged"/>

        <!-- 曜日別モード -->
        <CheckBox x:Name="DayOfWeekCheckBox" Grid.Row="3" Content="曜日別モードで使用する"
                  Margin="0,0,0,10" Checked="DayModeChanged" Unchecked="DayModeChanged"/>

        <!-- 子項目入力（グループモード時のみ） -->
        <DockPanel x:Name="ChildInputArea" Grid.Row="4" Margin="0,0,0,5">
            <Button Content="追加" DockPanel.Dock="Right" Width="50" Click="AddChild"/>
            <TextBox x:Name="ChildTextBox" Margin="0,0,5,0" KeyDown="ChildTextBox_KeyDown"/>
        </DockPanel>

        <!-- 子項目リスト（グループモード時のみ） -->
        <ListBox x:Name="ChildListBox" Grid.Row="5" DisplayMemberPath="Text">
            <ListBox.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="編集" Click="EditChild"/>
                    <MenuItem Header="削除" Click="DeleteChild"/>
                </ContextMenu>
            </ListBox.ContextMenu>
        </ListBox>

        <Button x:Name="MoveUpButton"   Content="↑ 上へ" Grid.Row="6" Margin="0,10,0,5" Click="MoveChildUp"/>
        <Button x:Name="MoveDownButton" Content="↓ 下へ" Grid.Row="7" Margin="0,0,0,10" Click="MoveChildDown"/>

        <!-- 曜日別テキスト設定（曜日別モード時のみ） -->
        <GroupBox x:Name="DayOfWeekPanel" Grid.Row="8"
                  Header="曜日別テキスト（空欄 = 通常テキストを使用）"
                  Margin="0,0,0,10" Padding="6,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="日" VerticalAlignment="Center" Margin="0,2"/>
                <TextBox   x:Name="SunBox" Grid.Row="0" Grid.Column="1" Margin="4,2"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="月" VerticalAlignment="Center" Margin="0,2"/>
                <TextBox   x:Name="MonBox" Grid.Row="1" Grid.Column="1" Margin="4,2"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="火" VerticalAlignment="Center" Margin="0,2"/>
                <TextBox   x:Name="TueBox" Grid.Row="2" Grid.Column="1" Margin="4,2"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="水" VerticalAlignment="Center" Margin="0,2"/>
                <TextBox   x:Name="WedBox" Grid.Row="3" Grid.Column="1" Margin="4,2"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="木" VerticalAlignment="Center" Margin="0,2"/>
                <TextBox   x:Name="ThuBox" Grid.Row="4" Grid.Column="1" Margin="4,2"/>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="金" VerticalAlignment="Center" Margin="0,2"/>
                <TextBox   x:Name="FriBox" Grid.Row="5" Grid.Column="1" Margin="4,2"/>

                <TextBlock Grid.Row="6" Grid.Column="0" Text="土" VerticalAlignment="Center" Margin="0,2"/>
                <TextBox   x:Name="SatBox" Grid.Row="6" Grid.Column="1" Margin="4,2"/>
            </Grid>
        </GroupBox>

        <Button Content="OK" Grid.Row="9" Height="30" Click="OkClick"/>
    </Grid>
</Window>
